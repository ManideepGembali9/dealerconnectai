# Application Base URL (used for metadata and Google OAuth redirect URIs)
# On Vercel this falls back automatically to your deployment origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signed HTTP-only portal session secret (set a strong random string in production)
AUTH_SECRET=replace-with-strong-random-secret

# Customer-Only Google OAuth 2.0 Credentials (Server-side only — never expose via NEXT_PUBLIC_*)
# Configure Authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
#   https://your-production-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Admin Portal Override Password
ADMIN_MASTER_PASSWORD=admin123

# Optional SMTP / Twilio for OTP delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
