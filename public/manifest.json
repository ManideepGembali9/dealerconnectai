{
  "id": "com.dealerconnectai.app",
  "name": "DealerConnect AI — Customer Shopping App",
  "short_name": "DealerConnect",
  "description": "Discover nearby verified neighborhood shops, compare live prices, check real-time stock, and enquire directly.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "portrait-primary",
  "background_color": "#0B0B0C",
  "theme_color": "#D4AF37",
  "categories": ["shopping", "business", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Categories Catalog",
      "url": "/categories",
      "description": "Browse all product categories"
    },
    {
      "name": "Nearby Shops",
      "url": "/nearby",
      "description": "Find verified shops closest to you"
    },
    {
      "name": "My Cart",
      "url": "/cart",
      "description": "View shopping cart and enquire to dealers"
    },
    {
      "name": "My Profile",
      "url": "/profile",
      "description": "Manage customer profile and chat"
    }
  ],
  "prefer_related_applications": false
}
